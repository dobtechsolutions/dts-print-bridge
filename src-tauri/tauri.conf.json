{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DTS Print Bridge",
  "version": "0.1.0",
  "identifier": "com.dobtechsolutions.printbridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DTS Print Bridge",
        "width": 520,
        "height": 640,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "DTS Print Bridge"
    },
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Local relay for WiFi thermal printers.",
    "longDescription": "Relays print jobs from Restaurant by Dob Tech Solutions to a WiFi thermal printer on the same local network."
  }
}
